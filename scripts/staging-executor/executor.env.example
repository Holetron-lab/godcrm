# /etc/godcrm-staging-executor/executor.env — root 0600. No secrets here; the
# channel key lives in its own file. Values are fixed by the administrator and
# never taken from a request.
STAGING_SOCKET=/run/godcrm-staging-executor/executor.sock
STAGING_CHANNEL_KEY_FILE=/etc/godcrm-staging-executor/channel.key
STAGING_SOURCE_REPO=/root/production/business-crm
STAGING_PREFLIGHT_TIMEOUT=120
STAGING_PREFLIGHT_REMOTE=1
STAGING_COORD_DB=godcrm_prod
STAGING_PEER_UIDS=0
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
