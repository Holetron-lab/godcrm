[Unit]
Description=GodCRM installed browser qualification (administrator only)
Conflicts=godcrm-staging-browser.service
Requires=godcrm-staging-browser-reaper.service docker.service
After=godcrm-staging-browser-reaper.service docker.service
[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/godcrm-staging-browser/qualify.py
WorkingDirectory=/opt/godcrm-staging-browser
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONPATH=
Restart=no
TimeoutStartSec=310
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/godcrm-staging-browser /var/lib/godcrm-staging-browser
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET
IPAddressDeny=any
IPAddressAllow=<DEV_IP>/32
StandardOutput=null
StandardError=null
