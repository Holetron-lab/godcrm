[Unit]
Description=GodCRM independent browser crash reaper
Requires=docker.service
After=docker.service
[Service]
Type=simple
User=root
Group=root
UMask=0077
RuntimeDirectory=godcrm-staging-browser
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=godcrm-staging-browser
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 -B /opt/godcrm-staging-browser/reaper.py
WorkingDirectory=/opt/godcrm-staging-browser
Environment=PYTHONNOUSERSITE=1
Environment=PYTHONPATH=
Restart=always
RestartSec=1
TimeoutStopSec=10
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/godcrm-staging-browser /var/lib/godcrm-staging-browser
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX
StandardOutput=null
StandardError=null
[Install]
WantedBy=multi-user.target
