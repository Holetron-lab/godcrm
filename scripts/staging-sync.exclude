# Applied even to tracked paths. No delete flags: target-owned files survive.
.git
.gitnexus
.mcp.json
.env*
*.env
*.env.*
*.local.*
*.bak*
*.backup*
*.old
*.original
*~
*.pem
*.key
credentials*.json
secrets*.json
*-config.json
*-tokens.json
.npmrc
.netrc
.ssh
.aws
.claude
.codex
.agents
node_modules
dist
.cache
logs
*.log
*.db
*.sqlite*
backups
.backups
temp
uploads
downloads
coverage
test-results
playwright-report
# Explicit manifests do not traverse excluded parents. Match descendants too.
**/.git/***
**/.gitnexus/***
**/.ssh/***
**/.aws/***
**/.claude/***
**/.codex/***
**/.agents/***
**/node_modules/***
**/dist/***
**/.cache/***
**/logs/***
**/backups/***
**/.backups/***
**/temp/***
**/uploads/***
**/downloads/***
**/coverage/***
**/test-results/***
**/playwright-report/***
/data/***
/pes-core/pes-data/***
/scripts/snapshots/***
# Other services and host-specific PM2 configuration are not staging app code.
/deploy/***
/deploy-bot/***
/ecosystem*.config.*
