PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ENCRYPTION_KEY=your-32-char-encryption-key-here
NODE_ENV=development
# Database Configuration
# Options: sqlite | postgres
DATABASE_TYPE=sqlite

# SQLite Configuration (default)
DATABASE_PATH=/var/lib/business-crm-data/crm.db

# PostgreSQL Configuration (when DATABASE_TYPE=postgres)
# Use either POSTGRES_URL or individual settings
# POSTGRES_URL=postgresql://user:password@localhost:5432/dbname

# Individual PostgreSQL settings (alternative to POSTGRES_URL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=godcrm
POSTGRES_USER=godcrm
POSTGRES_PASSWORD=your-secure-password

# ADR-0028 — Space Connectors
# Generate once: openssl rand -hex 32 ; same value on PROD and DEV
CRM_CREDENTIAL_KEY=

# OAuth provider credentials. Register an OAuth app at each provider with redirect URIs:
#   https://crm.hltrn.cc/api/v3/connectors/oauth/callback
#   https://devcrm.hltrn.cc/api/v3/connectors/oauth/callback
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ── Ops profiles broker (diagnostics / local-qa, Constitution v4.3) ───────────
# Installed by the deployment executor into a versioned, root-owned path outside
# every agent-writable root. Unset/unpinned = every ops_run_check is DENIED.
# OPS_EXECUTOR_SHA256 = sha256 over ops-runner.py + ops-runner/{profiles.py,
# diagnostics.py,pm2-status.cjs,browser-seccomp.json} (profiles.executor_digest).
OPS_EXECUTOR_ROOT=/opt/godcrm-ops/current
OPS_EXECUTOR_SHA256=
# local-qa only: pinned image IDs (sha256:…) and the read-only dependency dir.
OPS_QA_IMAGE=
OPS_QA_BROWSER_IMAGE=
OPS_QA_MODULES=

# Ring 0 OIDC cutover (executor-managed; append to the existing CORS allowlist).
# Activate together after staging acceptance; do not widen COOKIE_DOMAIN.
# OIDC_ISSUER=https://id.godcrm.ai
# CORS_ORIGINS=https://app.godcrm.ai,https://id.godcrm.ai
